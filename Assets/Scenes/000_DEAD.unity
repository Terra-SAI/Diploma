--- !u!114 &1052347574
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1052347565}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac4ef71a1c318374698c7eed3dd9ecfb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  animator: {fileID: 1336120751}
  dialogue:
    dialogueLines:
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0418 \u0447\u0442\u043E \u044D\u0442\u043E \u0431\u044B\u043B\u043E?"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u041D\u043E \u043A\u0430\u043A? \u041F\u043E\u0447\u0435\u043C\u0443
        \u044F \u0442\u0443\u0442?"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0410 \u0433\u0434\u0435 \u0431\u044B \u0442\u044B \u0445\u043E\u0442\u0435\u043B
        \u0431\u044B\u0442\u044C, \u0434\u0440\u0443\u0433 \u043C\u043E\u0439?"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0421\u0443\u0434\u044F \u043F\u043E \u0442\u0432\u043E\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C,
        \u044F\u0432\u043D\u043E \u043D\u0435 \u0442\u0443\u0442. \u041D\u043E \u044F
        \u0433\u043E\u0442\u043E\u0432 \u0442\u0435\u0431\u044F \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0438\u0442\u044C"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0422\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F
        \u043E\u0442 \u0438\u0437\u0431\u0440\u0430\u043D\u0438\u044F \u043D\u0435
        \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F. "
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0422\u0430\u043A \u0447\u0442\u043E \u0443\u0436 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F
        \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E \u043A\u043E\u043D\u0446\u0430"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u041C\u0433\u043C, \u043D\u043E \u043A\u0430\u043A \u0442\u044B \u044D\u0442\u043E
        \u0441\u0434\u0435\u043B\u0430\u043B? \u0418 \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C
        \u0431\u0443\u0434\u0435\u0442?"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0423 \u0432\u0441\u0435\u0445 \u0441\u0432\u043E\u0438 \u0441\u0435\u043A\u0440\u0435\u0442\u044B.
        \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u0432\u0435\u0440\u043D\u0443
        \u0442\u0435\u0431\u044F \u0442\u0443\u0434\u0430, \u043E\u0442\u043A\u0443\u0434\u0430
        \u0442\u044B \u043F\u0440\u0438\u0448\u0451\u043B."
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0411\u0443\u0434\u0442\u043E \u0431\u044B \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E"
