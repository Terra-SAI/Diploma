  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0427\u0442\u043E \u0437\u0430 \u043A\u0440\u044E\u043A\u0438 \u0432\u0438\u0441\u044F\u0442
        \u0438\u0437-\u043F\u043E\u0434 \u043F\u043E\u0442\u043E\u043B\u043A\u0430?"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0411\u0443\u0434\u0442\u043E \u043D\u0430 \u043D\u0438\u0445 \u043D\u0443\u0436\u043D\u043E
        \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u0432\u0435\u0441\u0438\u0442\u044C"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0418 \u044D\u0442\u043E\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
        \u043B\u0443\u0447 \u0441\u0432\u0435\u0442\u0430"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u041D\u0430\u0434\u043E \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F,
        \u0447\u0442\u043E \u0442\u0443\u0442 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442"
