--- !u!114 &864896185419573814
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1672085188}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c784d6c79ae42b54f91dac5f5a2c646b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u041D\u0435 \u043C\u043E\u0433\u0443 \u0442\u0430\u043A \u0432\u044B\u0439\u0442\u0438"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u042F \u0435\u0449\u0451 \u0441\u043C\u0435\u043D\u043D\u044B\u0435
        \u043D\u043E\u0441\u043A\u0438 \u043D\u0435 \u043D\u0430\u0448\u0451\u043B"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0421\u0442\u043E\u0438\u0442 \u0437\u0430\u043A\u0440\u044B\u0442\u044C
        \u043E\u043A\u043D\u043E, \u0440\u0430\u0437 \u0443\u0445\u043E\u0436\u0443
        \u043D\u0430 \u0441\u043C\u0435\u043D\u0443"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0415\u0449\u0451 \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u0431\u0440\u0430\u0442\u044C
        \u043E\u0431\u0435\u0434 \u0438\u0437 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0430"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0418 \u043D\u0435 \u0437\u0430\u0431\u044B\u0442\u044C \u043F\u043E\u043C\u044B\u0442\u044C
        \u043F\u043E\u0441\u0443\u0434\u0443"
