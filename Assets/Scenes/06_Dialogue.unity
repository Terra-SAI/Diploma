  m_Script: {fileID: 11500000, guid: 124bdd5a8d6760349a0599fd1283f5a2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  animator: {fileID: 185933242014826291}
  dialogue:
    dialogueLines:
    - character:
        name: "\u041C\u0430\u0440\u0438"
        icon: {fileID: 21300000, guid: 80bd0808f6123964bb7c5d355f384873, type: 3}
      line: "\u0422\u043E\u043C\u0430, \u0442\u044B \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
        \u0441\u0430\u043C \u043D\u0435 \u0441\u0432\u043E\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F.
        \u0427\u0442\u043E-\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: ...
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0410? \u0414\u0430 \u043D\u0435, \u0432\u0441\u0435 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E.
        \u041D\u0435 \u0432\u044B\u0441\u043F\u0430\u043B\u0441\u044F \u043F\u0440\u043E\u0441\u0442\u043E"
    - character:
        name: "\u0413\u0440\u0435\u0433"
        icon: {fileID: 21300000, guid: a5264f2942a920d46bbe1c03fd99ed9b, type: 3}
      line: "\u0410 \u0447\u0442\u043E \u0442\u0430\u043A? \u0412\u0440\u043E\u0434\u0435
        \u0435\u0449\u0451 \u043D\u0435 \u043F\u043E\u043B\u043D\u043E\u043B\u0443\u043D\u0438\u0435,
        \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0430\u0442\u044C \u043F\u043B\u043E\u0445\u043E?"
    - character:
        name: "\u0413\u0440\u0435\u0433"
        icon: {fileID: 21300000, guid: a5264f2942a920d46bbe1c03fd99ed9b, type: 3}
      line: "\u0414\u0430 \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0447\u0438\u043B\u043B\u043E\u0432\u044B\u0439
        \u043F\u0430\u0440\u0435\u043D\u044C. \u043C\u043D\u0435 \u043F\u043E\u0445\u0443\u0439
        \u043D\u0430 \u0442\u0432\u043E\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
        :)"
