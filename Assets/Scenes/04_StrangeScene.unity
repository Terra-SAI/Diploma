      line: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E \u0442\u0435\u0431\u044F!"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0410\u0430\u0430! \u0427\u0442\u043E \u0442\u044B \u0442\u0430\u043A\u043E\u0435?"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0422\u0432\u043E\u0439 \u0434\u0440\u0443\u0433, \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
        \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0427\u0442\u043E? \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
        \u043F\u043E\u043D\u0438\u043C\u0430\u044E. \u0422\u044B \u043C\u043D\u0435
        \u0441\u043D\u0438\u0448\u044C\u0441\u044F?"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0418 \u0434\u0430, \u0438 \u043D\u0435\u0442. \u041D\u043E \u043D\u0435\u0442
        \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C
        \u0432\u0441\u0451."
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430 \u0442\u0432\u043E\u044F
        \u043F\u043E\u043C\u043E\u0449\u044C, \u043A\u0430\u043A \u0438 \u0442\u0435\u0431\u0435
        \u043C\u043E\u044F."
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0413\u0434\u0435-\u0442\u043E \u0437\u0434\u0435\u0441\u0442\u044C
        \u0441\u043F\u0440\u044F\u0442\u0430\u043D \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u043C"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u041D\u0430\u0439\u0434\u0438 \u0435\u0433\u043E \u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u0438
        \u043A\u043E \u043C\u043D\u0435"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0427\u0442\u043E? \u042F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E!
        \u042D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
        \u0441\u043E\u043D, \u0438 \u043C\u043D\u0435 \u043D\u0430\u0434\u043E \u043F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u042D\u0442\u043E \u043D\u0435 \u0441\u043E\u043D, \u0422\u043E\u043C\u0430.
        \u0410\u043C\u0443\u043B\u0435\u0442, \u0447\u0442\u043E \u0442\u044B \u043D\u0430\u0448\u0451\u043B
        \u0441\u0435\u0433\u043E\u0434\u043D\u044F, \u043F\u043E\u043C\u043E\u0433
        \u043C\u043D\u0435 \u043D\u0430\u0439\u0442\u0438 \u0442\u0435\u0431\u044F"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0427\u0442\u043E \u0437\u0430 \u0430\u043C\u0443\u043B\u0435\u0442
        \u0432\u043E\u043E\u0431\u0449\u0435?"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0422\u043E\u0442, \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F
        \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0430\u0445. \u0410 \u0441\u0435\u0439\u0447\u0430\u0441
        \u043F\u0440\u043E\u0448\u0443. \u041D\u0430\u0439\u0434\u0438 \u043A\u0430\u043C\u0435\u043D\u044C!!"
  canCommunicate: 1
