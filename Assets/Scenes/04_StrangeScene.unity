--- !u!114 &1278931961
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1278931960}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c784d6c79ae42b54f91dac5f5a2c646b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u0412\u043E\u0442 \u0442\u0432\u043E\u0439 \u043A\u0430\u043C\u0435\u043D\u044C.
        \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u043E\u0438\u0437\u0432\u043E\u043B\u044C
        \u043E\u0431\u044A\u044F\u043D\u0438\u0442\u044C\u0441\u044F"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0427\u0442\u043E \u0436. \u0413\u0440\u0430\u043D\u044C \u043C\u0435\u0436\u0434\u0443
        \u043D\u0430\u0448\u0438\u043C\u0438 \u043C\u0438\u0440\u0430\u043C\u0438
        \u0441\u0442\u0438\u0440\u0430\u0435\u0442\u0441\u044F"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u0418 \u043D\u0430\u0448 \u043F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044C
        \u0440\u0435\u0448\u0438\u043B \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C
        \u0441\u0432\u043E\u0438 \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F."
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u041D\u043E \u0442\u0432\u043E\u0439 \u0430\u043C\u0443\u043B\u0435\u0442
        \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u043C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
        \u0435\u0433\u043E"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u044F
        \u043D\u0435 \u043C\u043E\u0433\u0443 \u0434\u043E\u043B\u0433\u043E \u0442\u0435\u0431\u044F
        \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0432 \u044D\u0442\u043E\u043C
        \u043C\u0438\u0440\u0435"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443, \u0441\u0435\u0439\u0447\u0430\u0441
        \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F \u0432
        \u0441\u0432\u043E\u0439 \u043C\u0438\u0440. \u0410 \u043D\u043E\u0447\u044C\u044E
        \u043C\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F
        \u0432\u043D\u043E\u0432\u044C"
    - character:
        name: "\u0422\u043E\u043C\u0430"
        icon: {fileID: 21300000, guid: 45a309949d742dc49b7ec05030fe45cb, type: 3}
      line: "\u042F \u0432\u0441\u0451 \u0435\u0449\u0451 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E"
    - character:
        name: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
        icon: {fileID: 21300000, guid: 3db1c499eb523d540b6e7d8a30ab38e6, type: 3}
      line: "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441! \u041F\u0440\u044B\u0433\u0430\u0439
        \u0432 \u043F\u043E\u0440\u0442\u0430\u043B"
